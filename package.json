{
  "name": "superstring",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Superstring compatible rewrite: local single-process evaluation build; distribution acceptance pending",
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.4.2"
  },
  "scripts": {
    "dev:server": "bun --watch src/server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:integration": "bun test tests/integration",
    "test:web": "vitest run --config vitest.config.ts",
    "check": "biome check .",
    "build:desktop": "node tools/desktop/build/build.mjs",
    "check:i18n": "i18next-cli extract --ci --config tools/verify/i18next.config.ts && i18next-cli lint --config tools/verify/i18next.config.ts"
  },
  "dependencies": {
    "@dicebear/core": "10.7.0",
    "@dicebear/styles": "10.6.0",
    "@fontsource-variable/geist": "5.3.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@tanstack/react-table": "9.2.4",
    "@visx/scale": "4.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.2",
    "eventsource-parser": "4.1.1",
    "file-type": "22.1.1",
    "highlight-words-core": "1.2.3",
    "hono": "4.13.7",
    "i18next": "26.4.2",
    "image-size": "2.0.4",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "omggif": "1.0.10",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-circular-progressbar": "2.2.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-resizable-panels": "4.13.3",
    "zod": "4.6.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/bun": "1.4.2",
    "@types/highlight-words-core": "1.2.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "bun": "1.4.2",
    "drizzle-kit": "0.31.10",
    "i18next-cli": "1.74.1",
    "jsdom": "27.4.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
